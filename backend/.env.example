# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/youtube-mate

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# JWT Secret (change this in production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# YouTube API Key (optional - for enhanced video metadata)
# YOUTUBE_API_KEY=your-youtube-api-key

# Gemini API Key (required for transcript summarization)
GEMINI_API_KEY=your-gemini-api-key-here

# Mistral API Key (required for standard video Q&A responses)
MISTRAL_API_KEY=your-mistral-api-key-here

# Domain Configuration
DEFAULT_DOMAIN=ytmate.co

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# QR Code Configuration
QR_CODE_SIZE=200
QR_CODE_MARGIN=2

# ── Redis / Valkey (optional — enables distributed cache, queues, socket adapter) ──
# Local dev: docker compose up -d redis, then:
# REDIS_URL=redis://localhost:6379
# Production (e.g. Aiven Valkey — TLS handled automatically for rediss://):
# REDIS_URL=rediss://default:<password>@<host>:<port>

# ── Background processing ──
# DOWNLOAD_QUEUE_MODE=inline | bullmq  (inline = original in-process behavior)
# ENABLE_CRON=false                    (set on API instances when a worker owns scheduling)
# WORKER_CONCURRENCY=2                 (worker process only)

# ── Object storage note ──
# On Render, set DOWNLOAD_DIR to a persistent disk mount (e.g. /var/data/downloads).
# Files are served exclusively through the authenticated /api/downloads/file/:id endpoint.
